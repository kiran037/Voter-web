# ==========================================
# Voter Web - Environment Variables Template
# ==========================================
# Copy this file to .env and replace placeholder values with your configuration:
#   cp .env.example .env

# --- Database (MySQL / RDS) ---
# For local Docker MySQL (docker compose up -d):
DATABASE_URL="mysql://root:supersecret@localhost:3307/voterdb"
# For production RDS:
# DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>"

# --- Auth & Session (JWT) ---
# Generate a strong 64-char secret: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-replace-with-a-random-hex-string"
SESSION_COOKIE_NAME="session"
SESSION_TTL_HOURS="24"
# Domain for session cookie (leave blank or localhost for local dev, e.g. .example.com for prod)
SESSION_COOKIE_DOMAIN=""

# --- OTP & SMS ---
# Provider: "log" (logs OTP to server console for local dev) or "twilio" (sends real SMS)
SMS_PROVIDER="log"

# Dev-only OTP bypass (enables hardcoded OTP for testing without sending SMS)
OTP_LOG_TO_CONSOLE=true
OTP_DEV_BYPASS="000000"

# Twilio SMS Configuration (Required if SMS_PROVIDER="twilio")
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM="+1234567890"

# SMS Preferences
SMS_TEMPLATE="Your OTP is {{CODE}}. It will expire in 15 minutes."
SMS_COUNTRY_CODE="+91"
SMS_RESEND_COOLDOWN_SEC="30"

# Optional Generic SMS Provider Config
SMS_SENDER_ID=""
SMS_API_KEY=""

# --- Seed Administrator ---
# Used when running `npm run db:seed`
SEED_ADMIN_PHONE="+919999999999"
SEED_ADMIN_NAME="Admin"

# --- Import & Processing Configuration ---
# File upload limits and batch import processing params
IMPORT_CONCURRENCY=12
IMPORT_CHUNK_SIZE=300
IMPORT_MAX_UPLOAD_BYTES=4500000
NEXT_PUBLIC_IMPORT_MAX_UPLOAD_BYTES=4500000
IMPORT_MAX_ROWS=50000
