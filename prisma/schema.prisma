// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////////////
// Enums
////////////////////////////////////////////////////////////

enum Gender {
  M
  F
  O
}

enum ColourCode {
  OUR
  OPPOSITE
  DOUBTFUL
  OTHER
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
}

enum UserRole {
  ADMIN
  STAFF
}

/// Optional classification for which kind of Family ID you're storing
enum FamilyIdType {
  JAN_AADHAAR_FAMILY_ID
  RATION_CARD_NO
  OTHER
}

/// Role (optional) relative to the chosen head in the same familyId
enum FamilyRole {
  HEAD
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

////////////////////////////////////////////////////////////
// Auth: OTP-only (no password) + JWT (no DB session table)
////////////////////////////////////////////////////////////

model User {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  phone           String    @unique @db.VarChar(20) // E.164 (e.g., +9198xxxxxxx)
  name            String?   @db.VarChar(191)
  role            UserRole  @default(STAFF)
  phoneVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  importBatches ImportBatch[]
}

model AuthOtp {
  id         BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  phone      String     @db.VarChar(20)
  purpose    OtpPurpose @default(LOGIN)
  codeHash   String     @db.VarChar(191) // store hash, never raw
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0) @db.UnsignedInt
  ip         String?    @db.VarChar(64)
  userAgent  String?    @db.VarChar(255)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, expiresAt])
  @@index([createdAt])
}

////////////////////////////////////////////////////////////
// Core: Voter (List + Detail + Survey)
////////////////////////////////////////////////////////////

model Voter {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  // List / Details tab
  name    String  @db.VarChar(191)
  voterId String? @unique(map: "uniq_voterId") @db.VarChar(64) // nullable if some rows miss it
  age     Int?    @db.UnsignedInt
  gender  Gender?
  village String? @db.VarChar(191)
  houseNo String? @db.VarChar(64)
  address String? @db.VarChar(512)

  // Booth & roll identifiers
  boothName String? @db.VarChar(191)
  boothNo   Int?    @db.UnsignedInt
  partNo    Int?    @db.UnsignedInt
  srn       Int?    @db.UnsignedInt

  // Contacts
  mobile1 String? @db.VarChar(20)
  mobile2 String? @db.VarChar(20)
  email   String? @db.VarChar(191)

  // Flags
  colourCode ColourCode @default(OTHER)
  voted      Boolean    @default(false)
  starVoter  Boolean    @default(false)
  dead       Boolean    @default(false)

  // Survey / profiling (pruned to essentials)
  caste      String?  @db.VarChar(191)
  profession String?  @db.VarChar(191)
  demands    String?  @db.VarChar(512)
  extraInfo  String?  @db.VarChar(512) // single flexible note field
  dob        DateTime?

  // 👉 Simple family linking (all members sharing the same familyId)
  familyId      String?       @db.VarChar(64)   // e.g., Jan Aadhaar Family ID / Ration Card No
  familyIdType  FamilyIdType? // optional classification
  relationToHead FamilyRole?  // optional; use "HEAD" for the designated head

  // Optional: self-reference to the head voter (no hard DB guarantee that it shares same familyId)
  headId  BigInt? @db.UnsignedBigInt
  head    Voter?  @relation("Voter_FamilyHead", fields: [headId], references: [id])
  members Voter[] @relation("Voter_FamilyHead") // those pointing to this voter as head

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ImportRow ImportRow[]

  @@index([name])
  @@index([village])
  @@index([boothNo, partNo, srn])
  @@index([mobile1])
  @@index([mobile2])
  @@index([familyId])
  @@index([headId])

  // Requires MySQL with FULLTEXT support on InnoDB (5.7+/8.0+)
  @@fulltext([name, village, address, boothName])
}

////////////////////////////////////////////////////////////
// Bulk Upload: Excel → Batch → Row results
////////////////////////////////////////////////////////////

model ImportBatch {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  fileName     String       @db.VarChar(255)
  status       ImportStatus @default(PENDING)
  rowCount     Int          @default(0) @db.UnsignedInt
  successCount Int          @default(0) @db.UnsignedInt
  failedCount  Int          @default(0) @db.UnsignedInt
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  uploadedById BigInt? @db.UnsignedBigInt
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  rows ImportRow[]

  @@index([status])
  @@index([createdAt])
}

model ImportRow {
  id      BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  batchId BigInt          @db.UnsignedBigInt
  status  ImportRowStatus @default(SKIPPED)
  error   String?         @db.VarChar(1024)

  // Raw Excel/CSV row (stringified JSON) for audit/debug
  raw String? @db.Text

  // Useful for dedupe/upsert logic during import
  voterIdStr String? @db.VarChar(64)
  phone1     String? @db.VarChar(20)
  // Optional: carry the family ID that came from the sheet (helps debugging)
  familyExternalId String? @db.VarChar(64)
  familyIdType     FamilyIdType?

  // If processed to a Voter, link it
  voterId BigInt? @db.UnsignedBigInt
  voter   Voter?  @relation(fields: [voterId], references: [id])

  createdAt DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id])

  @@index([batchId, status])
  @@index([voterId])
  @@index([voterIdStr])
  @@index([familyExternalId])
}
