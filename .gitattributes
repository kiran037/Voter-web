# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout.
*.ts text
*.tsx text
*.js text
*.mjs text
*.json text
*.md text
*.css text
*.yml text
*.yaml text
*.prisma text
*.sql text

# Denote all binary files that should not be modified by Git
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
